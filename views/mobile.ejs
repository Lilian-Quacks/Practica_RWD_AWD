<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogos de componentes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header>
        <h1>Catálogos de componentes</h1>
    </header>
    
    <div class="contenedor-principal" style="justify-content: center;">
        <main class="cuadricula-productos">
            <article class="tarjeta">
                <img src="/image/cpu.webp" alt="Procesador">
                <h3>Procesador AMD Ryzen</h3>
                <p>Procesador Ryzen serie 8000.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/ram.webp" alt="Memoria RAM">
                <h3>Memoria RAM 32GB DDR5</h3>
                <p>Memoria Kingston de alta velocidad.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/ssd.webp" alt="SSD NVMe">
                <h3>Disco SSD M.2 NVMe 1TB</h3>
                <p>Almacenamiento ADATA.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/gpu.webp" alt="Tarjeta gráfica">
                <h3>Tarjeta gráfica dedicada</h3>
                <p>Tarjeta gráfica ASUS.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/tarjetamadre.webp" alt="Tarjeta madre">
                <h3>Tarjeta madre ASUS</h3>
                <p>Conectividad y expansión.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/fuentepoder.webp" alt="Fuente de poder">
                <h3>Fuente de poder 750W</h3>
                <p>Energía para tu equipo.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/monitor.webp" alt="Monitor">
                <h3>Monitor Full HD</h3>
                <p>Pantalla ASUS de 27 pulgadas.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/mouse.webp" alt="Mouse">
                <h3>Mouse Acteck óptico USB</h3>
                <p>Alámbrico, 1000 DPI, color negro.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/disipador.webp" alt="Disipador para procesador">
                <h3>Disipador para procesador</h3>
                <p>Refrigeración líquida MSI.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/pastatermica.webp" alt="Pasta térmica">
                <h3>Pasta térmica</h3>
                <p>Pasta térmica Corsair TM30.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/tarjetared.webp" alt="Adaptador de red">
                <h3>Adaptador de red</h3>
                <p>Adaptador inalámbrico TP-Link.</p>
                <button>Comprar</button>
            </article>

            <article class="tarjeta">
                <img src="/image/teclado.webp" alt="Teclado">
                <h3>Teclado</h3>
                <p>Teclado alámbrico Acteck.</p>
                <button>Comprar</button>
            </article>
        </main>
    </div>
</body>
</html>